<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="220dp"
    android:paddingTop="12dp"
    android:layout_marginStart="12dp"
    android:background="@drawable/workout_item_bg"
    android:layout_height="230dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/picUrl"
        android:layout_width="198dp"
        android:layout_height="150dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/RoundedCorners"
        android:src="@drawable/pic_1"/>

    <TextView
        android:id="@+id/Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="title"
        android:layout_marginTop="14dp"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="@+id/picUrl"
        app:layout_constraintTop_toBottomOf="@+id/picUrl" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/Title"
        app:layout_constraintTop_toBottomOf="@+id/Title">

        <TextView
            android:id="@+id/WorkoutDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20min"
            android:textColor="@color/white" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/circle_dots" />

        <TextView
            android:id="@+id/CaloriesCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:text="160 Kal" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/circle_dots" />

        <TextView
            android:id="@+id/ExerciseCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:text="4 Exercise" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>